-- ===== UTILS =====
local function center()
	local v = Camera.ViewportSize
	return Vector2.new(v.X/2, v.Y/2)
end

local function isGlassLike(p)
	if not p or not p:IsA("BasePart") then return false end
	if p.Material == Enum.Material.Glass then return true end
	if p.Transparency >= 0.6 then return true end
	if string.find(p.Name:lower(),"glass") then return true end
	return false
end

local function visible(char)
	local head = char:FindFirstChild("Head")
	if not head then return false end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {LocalPlayer.Character, char}
	local r = workspace:Raycast(Camera.CFrame.Position, head.Position - Camera.CFrame.Position, params)
	return (not r) or isGlassLike(r.Instance)
end

local function valid(plr)
	if not plr or not plr.Character then return false end
	local c = plr.Character
	local h = c:FindFirstChild("Head")
	local hum = c:FindFirstChild("Humanoid")
	if not h or not hum or hum.Health <= 0 then return false end
	if not visible(c) then return false end

	-- ✅ JARAK AIMLOCK (STUDS)
	if (h.Position - Camera.CFrame.Position).Magnitude > MAX_AIM_DISTANCE then
		return false
	end

	local pos, on = Camera:WorldToViewportPoint(h.Position)
	if not on or pos.Z <= 0 then return false end
	if (Vector2.new(pos.X,pos.Y)-center()).Magnitude > CIRCLE_RADIUS then return false end

	local t = Camera:WorldToViewportPoint(h.Position + Vector3.new(0,h.Size.Y/2,0))
	local b = Camera:WorldToViewportPoint(h.Position - Vector3.new(0,h.Size.Y/2,0))
	if math.abs(t.Y-b.Y) < MIN_HEAD_PIXEL then return false end

	return true
end

-- ===== TARGET =====
local locked=nil
local function findBest()
	local best,bd
	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LocalPlayer and valid(p) then
			local pos = Camera:WorldToViewportPoint(p.Character.Head.Position)
			local d = (Vector2.new(pos.X,pos.Y)-center()).Magnitude
			if not best or d<bd then best,bd=p,d end
		end
	end
	return best
end

-- ===== LOOP =====
RunService.RenderStepped:Connect(function()
	if not ENABLED then
		circle.Visible=false
		dot.Visible=false
		credit.Visible=false
		for _,l in pairs(lines) do l.Visible=false end
		locked=nil
		return
	end

	local c = center()
	circle.Position = c
	dot.Position = c

	credit.Position = Vector2.new(c.X, c.Y + CIRCLE_RADIUS + 14)
	credit.Visible = true

	circle.Visible = true
	dot.Visible = true
	for _,l in pairs(lines) do l.Visible=false end

	if not valid(locked) then locked=findBest() end

	local curLook = Camera.CFrame.LookVector
	local camDelta = (curLook - lastCamLook).Magnitude
	lastCamLook = curLook
	local smooth = (camDelta < CAMERA_MOVE_THRESHOLD) and STRONG_SMOOTH or NORMAL_SMOOTH

	for _,p in ipairs(Players:GetPlayers()) do
		if p~=LocalPlayer and valid(p) then
			lines[p]=lines[p] or Drawing.new("Line")
			lines[p].Thickness=1
			local h=p.Character.Head
			local aimPos=h.Position + h.CFrame.UpVector*0.45
			local vp=Camera:WorldToViewportPoint(aimPos)
			lines[p].From=c
			lines[p].To=Vector2.new(vp.X,vp.Y)
			lines[p].Visible=true

			if p==locked then
				lines[p].Color=Color3.fromRGB(255,255,255)
				local cam=Camera.CFrame
				Camera.CFrame = cam:Lerp(CFrame.new(cam.Position,aimPos), smooth)
			else
				lines[p].Color=Color3.fromRGB(255,0,0)
			end
		end
	end
end)
